<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity"
    tools:ignore="UsingOnClickInXml,RtlSymmetry">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 1. Заголовок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/title"
                    android:textColor="@color/ink"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="7dp"
                    android:text="@string/badge"
                    android:textColor="@color/ink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Окно статистики -->
            <LinearLayout
                android:id="@+id/statsWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="7dp">

                <com.example.colortiles.WindowBar
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    app:barColor="@color/mint"
                    app:barTitle="stats.exe" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="@string/moves_label"
                            android:textColor="@color/muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/movesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:minWidth="48dp"
                            android:text="0"
                            android:textColor="@color/ink"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/loadingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="@string/loading"
                            android:textColor="@color/ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <!-- 16 сегментов: жёлтые = светлые плитки, синие = тёмные -->
                        <com.example.colortiles.SegmentBar
                            android:id="@+id/segmentBar"
                            android:layout_width="match_parent"
                            android:layout_height="20dp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/countText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Окно поля: board.exe - на всю ширину экрана
                 Чёрный фон + padding 3dp сверху/снизу = жирные линии-разделители -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/ink"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <com.example.colortiles.WindowBar
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    app:barColor="@color/butter"
                    app:barTitle="board.exe" />

                <!-- SquareLayout: высота = ширине -> поле квадратное -->
                <com.example.colortiles.SquareLayout
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                <!-- строка 0 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t00"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="00" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t01"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="01" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t02"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="02" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t03"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="03" />
                </LinearLayout>

                <!-- строка 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t10"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="10" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t11"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="11" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t12"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="12" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t13"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="13" />
                </LinearLayout>

                <!-- строка 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t20"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="20" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t21"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="21" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t22"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="22" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t23"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="23" />
                </LinearLayout>

                <!-- строка 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t30"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="30" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t31"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="31" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t32"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="32" />

                    <com.example.colortiles.RetroTile
                        android:id="@+id/t33"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:onClick="onClick"
                        android:tag="33" />
                </LinearLayout>
                </com.example.colortiles.SquareLayout>
            </LinearLayout>

            <!-- 4. Управление -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/hint_label"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hintLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="9dp"
                    android:text="@string/hint_light"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hintDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="9dp"
                    android:text="@string/hint_dark"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnNew"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="@string/new_game"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 5. Окно победы (скрыто) -->
    <LinearLayout
        android:id="@+id/winDialog"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="3dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.example.colortiles.WindowBar
            android:layout_width="match_parent"
            android:layout_height="30dp"
            app:barColor="@color/pink"
            app:barTitle="win.exe" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.example.colortiles.RetroTile
                android:id="@+id/winTile"
                android:layout_width="60dp"
                android:layout_height="60dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/win_title"
                    android:textColor="@color/ink"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/winBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/winOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingStart="18dp"
                android:paddingTop="7dp"
                android:paddingEnd="22dp"
                android:paddingBottom="11dp"
                android:text="@string/ok"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/winAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="18dp"
                android:paddingBottom="11dp"
                android:text="@string/again"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Слой с искорками -->
    <com.example.colortiles.SparkleView
        android:id="@+id/sparkles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
